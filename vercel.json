{
  "version": 2,
  "rewrites": [
    {
      "source": "/scene-state/:path*",
      "destination": "https://peachweb.io/scene-state/:path*"
    },
    {
      "source": "/:file((?!index\\.html|styles\\.css|website-base\\.css|sw\\.js|script\\.js|ui-state\\.json|peachweb-favico2n\\.png|robots\\.txt).+\\.(js|json|css|wasm|glb|gltf|webp|png|svg|jpg|mp4|woff|woff2|ttf|otf))",
      "destination": "https://peachweb.io/:file"
    }
  ]
}
